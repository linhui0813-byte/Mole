package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"strings"
	"syscall"
	"time"
	"unicode"

	"github.com/tw93/mole/desktop/pathbinding"
)

// This supplements, never weakens, upstream Analyze's protected-root policy.
func dashboardTrashPolicy(path string) error {
	if err := validateTrashTarget(path); err != nil {
		return err
	}
	home, err := os.UserHomeDir()
	if err != nil {
		return errors.New("home identity unavailable")
	}
	roots := []string{"Applications", ".ssh", ".gnupg", ".aws", ".azure", ".codex", ".claude", ".config", ".local/share",
		"Library/Keychains", "Library/Accounts", "Library/Mail", "Library/Calendars", "Library/Contacts",
		"Library/Logs/mole", "Library/Mobile Documents", "Library/CloudStorage"}
	for _, rel := range roots {
		root := filepath.Join(home, rel)
		if path == root || isSameExistingPath(path, root) || isPathWithinExistingRoot(path, root) {
			return fmt.Errorf("protected state root is kept: %s; inspect it in Finder", root)
		}
		if strings.HasPrefix(root, path+string(filepath.Separator)) || isPathWithinExistingRoot(root, path) {
			return fmt.Errorf("folder contains protected state root %s; choose an item inside the folder instead", root)
		}
	}
	for _, rel := range []string{"Desktop", "Documents", "Downloads", "Pictures", "Movies", "Music", "Public"} {
		root := filepath.Join(home, rel)
		if path == root || isSameExistingPath(path, root) {
			return fmt.Errorf("personal folder root is kept: %s; choose an item inside it", root)
		}
	}
	if path == filepath.Join(home, "Library") || path == filepath.Join(home, "Library/Application Support") || path == filepath.Join(home, "Library/Containers") || path == filepath.Join(home, "Library/Group Containers") {
		return errors.New("application-state collection root is kept; explore inside it")
	}
	for _, component := range strings.Split(path, string(filepath.Separator)) {
		lower := strings.ToLower(component)
		if strings.HasSuffix(lower, ".app") {
			return fmt.Errorf("application bundles are kept: %s; use an app-uninstall workflow", path)
		}
		if lower == ".git" {
			return fmt.Errorf("Git metadata is kept: %s; inspect the project in Finder", path)
		}
		if lower == ".aws" || lower == ".azure" || lower == ".codex" || lower == ".claude" || lower == ".config" || lower == ".ssh" || lower == ".gnupg" || lower == ".env" || strings.HasPrefix(lower, ".env.") {
			return fmt.Errorf("recognized credentials or session state are kept: %s", path)
		}
	}
	auth := filepath.Join(home, "Library/Caches/aws_credentials_cache.json")
	if path == auth || isSameExistingPath(path, auth) {
		return errors.New("authentication cache is kept")
	}
	return nil
}

func dashboardValidateTree(path string) error {
	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
	defer cancel()
	return dashboardValidateTreeWithin(ctx, path, 10000)
}

// A whole user folder is an explicit data action, separate from automatic
// cleanup. It includes nested projects, build bundles and local settings. Walk
// physically: moving a directory carries links without visiting their targets.
// Root protection and binding remain mandatory; the shell separately retains
// the loaded whitelist and account-scoped database checks at the final guard.
func dashboardValidateProject(path string) error {
	return dashboardValidateWholeFolder(path, "project")
}

func dashboardValidateFolder(path string) error {
	return dashboardValidateWholeFolder(path, "folder")
}

func dashboardValidateLibraryFolder(path string) error {
	return dashboardValidateWholeFolder(path, "library")
}

func dashboardValidateWholeFolder(path string, scope string) error {
	if _, err := pathbinding.Read(path); err != nil {
		return dashboardReviewError(path, err)
	}
	if err := dashboardTrashPolicy(path); err != nil {
		return err
	}
	home, _ := os.UserHomeDir()
	supported := false
	switch scope {
	case "project":
		supported = pathbinding.WholeProject(path)
	case "folder":
		supported = pathbinding.WholeFolderIn(home, path)
	case "library":
		supported = pathbinding.WholeLibraryFolderIn(home, path)
	}
	if !supported {
		return errors.New("whole-folder identity changed or is unsupported; scan and review again")
	}
	root, err := os.Lstat(path)
	if err != nil {
		return dashboardReviewError(path, err)
	}
	device := root.Sys().(*syscall.Stat_t).Dev
	auth, _ := os.Stat(filepath.Join(home, "Library/Caches/aws_credentials_cache.json"))
	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
	defer cancel()
	count := 0
	return filepath.WalkDir(path, func(p string, d fs.DirEntry, walkErr error) error {
		if walkErr != nil {
			return dashboardReviewError(p, walkErr)
		}
		if ctx.Err() != nil || count >= 1000000 {
			return errors.New("whole-folder review reached its 8-second or 1,000,000-entry limit; choose a smaller folder")
		}
		count++
		if strings.IndexFunc(p, unicode.IsControl) >= 0 {
			return errors.New("folder contains a control character in a path; inspect it in Finder")
		}
		info, err := d.Info() // Lstat: internal links never resolve to outside data.
		if err != nil {
			return dashboardReviewError(p, err)
		}
		if info.Sys().(*syscall.Stat_t).Dev != device {
			return fmt.Errorf("folder contains another mounted filesystem: %s; inspect it in Finder", p)
		}
		if info.Mode()&os.ModeSymlink != 0 {
			return nil
		}
		if !info.IsDir() && !info.Mode().IsRegular() {
			return fmt.Errorf("folder contains a socket or special file: %s; close its owner and review again", p)
		}
		if auth != nil && os.SameFile(auth, info) {
			return errors.New("authentication cache alias is kept")
		}
		name := strings.ToLower(d.Name())
		// A nested app moves intact with its reviewed parent. Selecting an app
		// or any of its contents directly still fails dashboardTrashPolicy above.
		if name == ".ssh" || name == ".gnupg" || name == ".aws" || name == ".azure" {
			return fmt.Errorf("recognized credentials or session state are kept: %s; inspect it in Finder", p)
		}
		if strings.Contains(p, string(filepath.Separator)+".git"+string(filepath.Separator)) && strings.HasSuffix(name, ".lock") {
			return fmt.Errorf("Git operation lock is present: %s; finish or close Git operations before reviewing again", p)
		}
		if d.IsDir() {
			if profile := dashboardBrowserProfile(p); profile != "" {
				return fmt.Errorf("browser profile is kept to protect sign-ins and session data: %s; inspect it in Finder", profile)
			}
		}
		return nil
	})
}

func dashboardReviewError(path string, err error) error {
	if errors.Is(err, os.ErrPermission) {
		return fmt.Errorf("macOS denied access to %s; check Finder Sharing & Permissions and Mole Dashboard access in System Settings > Privacy & Security, then scan again", path)
	}
	return fmt.Errorf("cannot review %s: %w; scan again or inspect it in Finder", path, err)
}

// Recognize exact profile metadata before walking a potentially huge cache.
// Only file types and names are inspected; no credential contents are read.
func dashboardBrowserProfile(path string) string {
	regular := func(path string) bool {
		info, err := os.Lstat(path)
		return err == nil && info.Mode().IsRegular()
	}
	profile := func(dir string) bool {
		info, err := os.Lstat(dir)
		if err != nil || !info.IsDir() {
			return false
		}
		if !regular(filepath.Join(dir, "Preferences")) {
			return false
		}
		if regular(filepath.Join(dir, "Cookies")) || regular(filepath.Join(dir, "Login Data")) {
			return true
		}
		network, err := os.Lstat(filepath.Join(dir, "Network"))
		return err == nil && network.IsDir() && regular(filepath.Join(dir, "Network/Cookies"))
	}
	dir := path
	if info, err := os.Lstat(path); err == nil && !info.IsDir() {
		switch filepath.Base(path) {
		case "Local State":
			dir = filepath.Dir(path)
		case "Cookies", "Cookies-wal", "Cookies-shm", "Login Data", "Login Data-wal", "Login Data-shm",
			"Preferences", "Secure Preferences", "History", "History-wal", "History-shm", "Web Data", "Web Data-wal", "Web Data-shm":
			dir = filepath.Dir(path)
			if filepath.Base(dir) == "Network" {
				dir = filepath.Dir(dir)
			}
		default:
			return ""
		}
	}
	if profile(dir) || regular(filepath.Join(dir, "Local State")) && profile(filepath.Join(dir, "Default")) {
		return dir
	}
	return ""
}

func dashboardValidateTreeWithin(ctx context.Context, path string, entryLimit int) error {
	if _, err := pathbinding.Read(path); err != nil {
		return dashboardReviewError(path, err)
	}
	count := 0
	return filepath.WalkDir(path, func(p string, d fs.DirEntry, err error) error {
		if err != nil {
			return dashboardReviewError(p, err)
		}
		if ctx.Err() != nil {
			return errors.New("folder review reached its 8-second safety limit; review a smaller subfolder")
		}
		if count >= entryLimit {
			return fmt.Errorf("folder review supports at most %s entries per item; review a smaller subfolder", formatNumber(int64(entryLimit)))
		}
		count++
		if d.Type()&os.ModeSymlink != 0 {
			return fmt.Errorf("folder contains a symbolic link: %s; reveal it in Finder to review", p)
		}
		if !d.IsDir() && !d.Type().IsRegular() {
			return fmt.Errorf("folder contains a socket or special file: %s; close its owner and review it in Finder", p)
		}
		if profile := dashboardBrowserProfile(p); profile != "" {
			return fmt.Errorf("browser profile is kept to protect sign-ins and session data: %s; inspect it in Finder", profile)
		}
		return dashboardTrashPolicy(p)
	})
}

// Private helper endpoints are invoked only with fixed argument arrays.
func dashboardPolicyMain(args []string) (bool, error) {
	if len(args) == 2 && args[0] == "--validate-trash" {
		return true, dashboardValidateTree(args[1])
	}
	if len(args) == 3 && (args[0] == "--check-binding" || args[0] == "--check-project-binding" || args[0] == "--check-folder-binding" || args[0] == "--check-library-folder-binding") {
		var b pathbinding.Binding
		if json.Unmarshal([]byte(args[2]), &b) != nil || b.Path != args[1] || !b.Matches() {
			return true, errors.New("item or parent changed; scan again")
		}
		if args[0] == "--check-project-binding" {
			return true, dashboardValidateProject(b.Path)
		}
		if args[0] == "--check-folder-binding" {
			return true, dashboardValidateFolder(b.Path)
		}
		if args[0] == "--check-library-folder-binding" {
			return true, dashboardValidateLibraryFolder(b.Path)
		}
		return true, dashboardValidateTree(b.Path)
	}
	return false, nil
}

func dashboardBindings(ctx context.Context, result jsonOutput) map[string]pathbinding.Binding {
	bindings := make(map[string]pathbinding.Binding)
	add := func(path string) {
		if ctx.Err() != nil {
			return
		}
		if b, err := pathbinding.Read(path); err == nil {
			bindings[path] = b
		}
	}
	for _, entry := range result.Entries {
		if entry.ScanStatus != scanUnavailable {
			add(entry.Path)
		}
	}
	for _, file := range result.LargeFiles {
		add(file.Path)
	}
	return bindings
}
